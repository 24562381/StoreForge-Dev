# ==============================================================================
# 🛍️ StoreForge Platform — Environment Configuration
# ==============================================================================

# Micro-Service Server Ports
PORT=3000
ADMIN_PORT=4000
BACKEND_PORT=8585

# Service URLs
# Server-side only backend URLs for secure reverse proxying (never exposed to browser clients)
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:4000"
BACKEND_URL="http://localhost:8585"
API_URL="http://localhost:8585"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"

# PostgreSQL Database Connection URL (Supabase, Neon, Railway, Docker, Localhost)
# DATABASE_URL="postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:[DB_PORT]/[DB_NAME]?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
# Optional: Dedicated DB override when running inside Docker containers (defaults to internal container: postgres:5432)
# DOCKER_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres?schema=public"

# Security & Authentication Secrets
# Mandatory: Cryptographic key used to sign and verify JWT authentication tokens for admin & staff sessions.
# In production, replace this with a secure random 256-bit hexadecimal key.
# You can generate the key via this command: `openssl rand -hex 32`. 
# Just copy and paste it in the terminal. 
# Note: openssl must be installed on your machine. If not, just install and run the command again.
JWT_SECRET="storeforge_super_secure_jwt_secret_change_in_production_2026"

# Optional Payment Gateway (bKash) Configuration
# Leave blank if using Cash on Delivery (COD) only.
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL=""
